/sahabeden/quotes.v1.json
  Cache-Control: public, max-age=0, s-maxage=21600, stale-while-revalidate=259200

/library/catalog.v1.json
  Cache-Control: public, max-age=0, s-maxage=21600, stale-while-revalidate=259200

/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=3600

/index.html
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=3600

/hourly
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=3600

/muasir
